<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Vista</RootNamespace>
    <AssemblyName>PlanillaRH</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>PlanillaRH - Sistema de Planilla y Recursos Humanos</AssemblyTitle>
    <Product>PlanillaRH</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <ProjectReference Include="..\Modelos\Modelos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Coloque su manual de usuario en Vista\Ayuda\ManualUsuario.html (se abre con F1 o con el botón Ayuda) -->
    <None Include="Ayuda\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
